<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text Count"
        Width="360"
        Height="320"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Text Type" Margin="0,0,0,4" FontWeight="Bold"/>
        <ComboBox x:Name="cboTextType" Grid.Row="1" Height="28" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="Prefix (optional)" Margin="0,0,0,4" FontWeight="Bold"/>
        <TextBox x:Name="txtPrefix" Grid.Row="3" Height="28" Margin="0,0,0,10"/>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Text="Starting Number" Margin="0,0,0,4" FontWeight="Bold"/>
                <TextBox x:Name="txtStart" Height="28"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="Increment Amount" Margin="0,0,0,4" FontWeight="Bold"/>
                <TextBox x:Name="txtIncrement" Height="28"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="5" Text="Suffix (optional)" Margin="0,0,0,4" FontWeight="Bold"/>
        <TextBox x:Name="txtSuffix" Grid.Row="6" Height="28" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="7" VerticalAlignment="Bottom">
            <TextBlock x:Name="lblPreview" Text="Next value: 1" Margin="0,0,0,6" FontStyle="Italic"/>
            <TextBlock x:Name="lblStatus" Text="Choose a text type and click Place Text." Margin="0,0,0,10" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnPlace" Content="Place Text" Width="100" Height="30" Margin="0,0,8,0"/>
                <Button x:Name="btnClose" Content="Close" Width="80" Height="30"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>