<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWG Layers"
        Height="550" Width="750"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- DWG selection -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="DWG:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="cmbDWG" Width="250"
                      DisplayMemberPath="Name"/>
        </StackPanel>

        <!-- Layers grid -->
        <DataGrid x:Name="dgLayers"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Layer Name"
                                    Binding="{Binding Path=LayerName}"
                                    IsReadOnly="True"
                                    Width="*"/>
                <DataGridCheckBoxColumn Header="On"
                                        Binding="{Binding Path=IsOn}"
                                        Width="60"/>
                <DataGridTextColumn Header="Color (debug)"
                                    Binding="{Binding Path=Color}"
                                    Width="120"/>
                <DataGridTextColumn Header="Line Pattern"
                                    Binding="{Binding Path=LinePatternName}"
                                    Width="120"/>
                <DataGridTextColumn Header="Line Weight"
                                    Binding="{Binding Path=LineWeight}"
                                    Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnBack" Content="Back" Width="80" Margin="0,0,10,0"/>
            <Button x:Name="btnCancel" Content="Cancel" Width="80" Margin="0,0,10,0"/>
            <Button x:Name="btnNext" Content="Next" Width="80" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
