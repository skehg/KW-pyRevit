<Window x:Class="pyRevit.DWGLayers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DWG Layer Overrides" Width="650" Height="480" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Select DWG Link:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="DwgCombo" Width="350" Margin="0,0,0,0"/>
        </StackPanel>
        
        <DataGrid Grid.Row="2" x:Name="LayerGrid" AutoGenerateColumns="False" Margin="0,5,0,5" 
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Layer Name" Binding="{Binding LayerName}" Width="200"/>
                <DataGridCheckBoxColumn Header="On/Off" Binding="{Binding IsVisible}" Width="60"/>
                <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="100"/>
                <DataGridTextColumn Header="Line Pattern" Binding="{Binding LinePattern}" Width="150"/>
                <DataGridTextColumn Header="Line Weight" Binding="{Binding LineWeight}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,5,0" x:Name="CancelBtn"/>
            <Button Content="Next" Width="80" x:Name="NextBtn"/>
        </StackPanel>
    </Grid>
</Window>
