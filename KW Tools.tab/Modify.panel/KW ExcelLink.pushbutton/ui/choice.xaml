<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="550" MinWidth="420" MinHeight="350"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="#FFF6F7F9">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="lblTitle" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock x:Name="lblContext" FontSize="12" TextWrapping="Wrap"
                       Foreground="#566273" Margin="0,0,0,10"/>
            <StackPanel x:Name="pnlGridLayout" Orientation="Horizontal"
                        Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock Text="Grid layout:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="cboGridLayout" MinWidth="210" Height="27"
                          VerticalContentAlignment="Center"/>
            </StackPanel>
        </StackPanel>
        <DockPanel Grid.Row="1">
            <TextBox DockPanel.Dock="Top" x:Name="txtSearch" MinHeight="28"
                     Margin="0,0,0,8" Padding="5,2" VerticalContentAlignment="Center"
                     ToolTip="Filter options by name" TextChanged="on_search_changed"/>
            <ListBox x:Name="lstChoices" SelectionMode="Single"
                     SelectionChanged="on_selection_changed"/>
        </DockPanel>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="btnBack" Width="90" Height="31"
                    DockPanel.Dock="Left" Click="on_back" AutomationProperties.Name="Back">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M8 0 L0 5 L8 10 Z" Width="8" Height="10"
                          Stretch="Fill" VerticalAlignment="Center" Margin="0,0,6,0"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text="Back" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" Height="31" Margin="8,0"
                        Click="on_cancel"/>
                <Button Content="Next" Width="90" Height="31" Click="on_continue"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
