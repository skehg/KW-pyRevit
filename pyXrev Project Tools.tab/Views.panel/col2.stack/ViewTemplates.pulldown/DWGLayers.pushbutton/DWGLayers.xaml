<Window x:Class="pyRevit.DWGLayers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DWG Layer Overrides" Width="900" Height="560" ResizeMode="CanResize" MinWidth="780" MinHeight="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Select DWG Link:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="DwgCombo" Width="350" Margin="0,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Bulk Update Selected Layers" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <WrapPanel>
                    <CheckBox x:Name="BatchVisibleValue" IsThreeState="True" IsChecked="{x:Null}" Content="On/Off (checked=on, unchecked=off, indeterminate=ignore)" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Color (R,G,B):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="BatchColorBox" Width="120" Margin="0,0,12,0" ToolTip="Leave blank to ignore. Enter &lt;No Override&gt; to clear override."/>
                    <TextBlock Text="Line Type:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="BatchLinePatternCombo" Width="210" Margin="0,0,12,0"/>
                    <TextBlock Text="Line Weight:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="BatchLineWeightBox" Width="90" Margin="0,0,12,0" ToolTip="Leave blank to ignore. Enter &lt;No Override&gt; to clear override."/>
                    <Button x:Name="ApplyToSelectedBtn" Content="Update Selected Layers" MinWidth="150" Height="24"/>
                </WrapPanel>
                <TextBlock Margin="0,6,0,0" Foreground="Gray" Text="Note: Enter &lt;no override&gt; in Color or Line Weight to clear that override."/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="Use Ctrl/Shift to select multiple rows in the layer grid." Foreground="Gray" Margin="0,0,0,8"/>
        
        <DataGrid Grid.Row="3" x:Name="LayerGrid" AutoGenerateColumns="False" Margin="0,5,0,5" 
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Layer Name" Binding="{Binding LayerName}" Width="250" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="On/Off" Binding="{Binding IsVisible}" Width="60"/>
                <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="100"/>
                <DataGridTextColumn Header="Line Pattern" Binding="{Binding LinePattern}" Width="190"/>
                <DataGridTextColumn Header="Line Weight" Binding="{Binding LineWeight}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,5,0" x:Name="CancelBtn"/>
            <Button Content="Next" Width="80" x:Name="NextBtn"/>
        </StackPanel>
    </Grid>
</Window>
