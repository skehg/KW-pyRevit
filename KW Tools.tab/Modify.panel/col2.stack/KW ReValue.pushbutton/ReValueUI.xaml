<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Koala ReValue - Advanced Pattern Mapping"
        Height="950" Width="1050" MinHeight="500" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ButtonStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="TokenDirectionStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Foreground" Value="#082F49"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="segment" Background="#F0F9FF"
                                BorderBrush="#7DA9BF" BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="segment" Property="Background" Value="#BAE6FD"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="segment" Property="Background" Value="#38BDF8"/>
                                <Setter TargetName="segment" Property="BorderBrush" Value="#0369A1"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="segment" Property="BorderBrush" Value="#082F49"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="segment" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <LinearGradientBrush x:Key="TokenRaisedFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#9BDFFA" Offset="0"/>
            <GradientStop Color="#38BDF8" Offset="0.45"/>
            <GradientStop Color="#0EA5E9" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TokenHoverFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#BAEAFE" Offset="0"/>
            <GradientStop Color="#7DD3FC" Offset="0.45"/>
            <GradientStop Color="#38BDF8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TokenPressedFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0284C7" Offset="0"/>
            <GradientStop Color="#38BDF8" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="TokenPillStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource TokenRaisedFill}"/>
            <Setter Property="Foreground" Value="#082F49"/>
            <Setter Property="BorderBrush" Value="#0284C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="pill_surface">
                            <Border x:Name="pill" CornerRadius="11"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0C4A6E" BlurRadius="3"
                                                      ShadowDepth="1" Direction="270" Opacity="0.3"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="pill_highlight" CornerRadius="10" Margin="1"
                                    BorderThickness="0,1,0,1" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#BFFFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.45"/>
                                        <GradientStop Color="#40075A86" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                            <Border Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill" Property="Background"
                                        Value="{StaticResource TokenHoverFill}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pill" Property="Background"
                                        Value="{StaticResource TokenPressedFill}"/>
                                <Setter TargetName="pill" Property="Effect" Value="{x:Null}"/>
                                <Setter TargetName="pill_highlight" Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="pill" Property="BorderBrush" Value="#082F49"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="pill_surface" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="pill" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="24"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource RaisedButtonStyle}">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="settings_row" Height="Auto" MinHeight="28"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="preview_row" Height="3*" MinHeight="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="3,0,3,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3*" MinWidth="110" MaxWidth="306"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*" MinWidth="110" MaxWidth="226"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="108"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Mode:"/>
                    <ToggleButton x:Name="btn_mode" IsChecked="False" Margin="5,0,8,0"
                                  AutomationProperties.Name="Mode: Type or Instance">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource NeutralSwitchStyle}">
                                <Setter Property="Content" Value="Type"/>
                                <Setter Property="Tag" Value="Instance"/>
                                <Setter Property="ToolTip" Value="Type mode: works on element types. Click to switch to Instance mode."/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="ToolTip" Value="Instance mode: works directly on selected instances, such as views and walls. Click to switch to Type mode."/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Source:" ToolTip="Source parameter"/>
                <ComboBox x:Name="combo_orig_param" Grid.Column="2" Margin="6,0,0,0"
                          ToolTip="The bracketed Default option uses the system name shown for this selection and mode. Select a parameter to use its value instead."/>
                <TextBlock Grid.Column="3" Text="Sort by:" Margin="8,0,0,0"/>
                <ComboBox x:Name="combo_sort_by" Grid.Column="4" Margin="6,0,0,0"
                          ToolTip="Order the preview rows. The counter and sequences number rows in this order. Click the Current Value header to sort by Current Value."/>
                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <ToggleButton x:Name="btn_sort_direction" Margin="5,0,0,0"
                                  AutomationProperties.Name="Sort direction: Ascending or Descending">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource NeutralSwitchStyle}">
                                <Setter Property="Content" Value="Asc"/>
                                <Setter Property="Tag" Value="Desc"/>
                                <Setter Property="ToolTip" Value="Sorted ascending. Click to sort descending. Blank values always sort last."/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="ToolTip" Value="Sorted descending. Click to sort ascending. Blank values always sort last."/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </StackPanel>
                <Grid Grid.Column="6" Width="105" HorizontalAlignment="Right">
                    <Button x:Name="btn_clear_sort" Content="X" Width="24" Margin="0" Padding="2"
                            HorizontalAlignment="Left"
                            ToolTip="Clear sort order (restore selection order)."
                            AutomationProperties.Name="Clear sort order"/>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,6">
                <ComboBox x:Name="combo_editor_mode" Width="130" SelectedIndex="0"
                          ToolTip="Build a pattern with chips, or edit the existing syntax directly.">
                    <ComboBoxItem Content="Tokens"/>
                    <ComboBoxItem Content="Advanced Pattern"/>
                </ComboBox>
            </StackPanel>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txt_pattern" Grid.Column="0"
                         Height="28" FontSize="12" FontFamily="Courier New"/>
                <ToggleButton x:Name="btn_use_orig" Grid.Column="1"
                              Margin="5,0" Padding="3,3" IsChecked="False"
                              AutomationProperties.Name="Pattern input: Pattern or Source">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource NeutralSwitchStyle}">
                            <Setter Property="Content" Value="Pattern"/>
                            <Setter Property="Tag" Value="Source"/>
                            <Setter Property="ToolTip" Value="Using your pattern. Click to use Source ({orig}, the complete source value)."/>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#287D46"/>
                                    <Setter Property="ToolTip" Value="Using Source ({orig}). Click to restore your previous pattern."/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <TextBlock Text="Final Case:" Grid.Column="2" Margin="12,0,6,0"/>
                <ComboBox x:Name="combo_final_case" Grid.Column="3" Width="105"
                          ToolTip="Convert the complete generated value after Find/Replace.">
                    <ComboBoxItem Content="None" Tag="None"/>
                    <ComboBoxItem Content="UPPER" Tag="upper"/>
                    <ComboBoxItem Content="lower" Tag="lower"/>
                    <ComboBoxItem Content="Title Case" Tag="title"/>
                    <ComboBoxItem Content="Sentence case" Tag="sentence"/>
                </ComboBox>
            </Grid>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                <StackPanel x:Name="token_editor_panel" Visibility="Visible">
                    <TextBlock x:Name="token_sample" Text="Sample (selection / first visible row)" Foreground="DimGray"
                               TextTrimming="CharacterEllipsis" Margin="3,0"/>
                    <ScrollViewer MaxHeight="68" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="token_palette"/>
                    </ScrollViewer>
                    <DockPanel Margin="0,3">
                        <Button x:Name="btn_add_token" Content="+ Add" DockPanel.Dock="Right"
                                VerticalAlignment="Top" Margin="3,0" Padding="6,4"/>
                        <Border BorderBrush="LightSlateGray" BorderThickness="1" CornerRadius="3">
                            <ScrollViewer x:Name="token_bar_scroll" MinHeight="38" MaxHeight="72"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <WrapPanel x:Name="token_bar" MinHeight="36" Background="Transparent"/>
                                    <Canvas IsHitTestVisible="False" ClipToBounds="True">
                                        <Path x:Name="token_insertion_caret" Visibility="Collapsed"
                                              Stroke="#082F49" StrokeThickness="1.5"
                                              Data="M0,0 L4,0 M2,0 L2,22 M0,22 L4,22"/>
                                    </Canvas>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </StackPanel>
                <TextBlock x:Name="token_status" TextWrapping="Wrap" Foreground="DimGray"
                           FontSize="11" Margin="3,0,3,4"/>
            </StackPanel>

            <TextBlock Text="Find/Replace:" Grid.Row="3" Grid.Column="0" Margin="3,0,10,6"/>
            <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Find" Grid.Column="0" Margin="0,0,6,0"/>
                <TextBox x:Name="txt_find" Grid.Column="1" FontSize="11" FontFamily="Courier New"/>
                <TextBlock Text="Replace" Grid.Column="2" Margin="12,0,6,0"/>
                <TextBox x:Name="txt_replace" Grid.Column="3" FontSize="11" FontFamily="Courier New"/>
            </Grid>

            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,3">
                <CheckBox x:Name="chk_match_whole_word" Content="Match Whole Word"
                          IsChecked="False" Margin="0,0,20,0"
                          ToolTip="Match only when the surrounding characters are not letters, digits or underscores."/>
                <CheckBox x:Name="chk_match_case" Content="Match Case" IsChecked="True"
                          ToolTip="Require the same uppercase and lowercase letters as the Find text."/>
            </StackPanel>
        </Grid>

        <Expander x:Name="more_settings" Grid.Row="1" IsExpanded="False"
                  Header="More Settings - Parameters, Delimiters, Counter &amp; Tokens"
                  Margin="3,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="0,4,0,0">
                <StackPanel Margin="3,0,6,3">
                    <GroupBox Header="Filter by Parameter (independent of the value being modified)">
                        <DockPanel>
                            <Button x:Name="btn_clear_filters" Content="Clear" DockPanel.Dock="Right"/>
                            <Button x:Name="btn_edit_filters" Content="Edit Filters..." DockPanel.Dock="Right"/>
                            <TextBlock x:Name="txt_filter_summary" Text="No parameter filters" TextWrapping="Wrap"/>
                        </DockPanel>
                    </GroupBox>
                    <GroupBox Header="Parameters for Pattern ({param1} through {param5})">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Param 1:" Grid.Row="0" Grid.Column="0"/>
                            <ComboBox x:Name="combo_param1" Grid.Row="0" Grid.Column="1" Margin="3,0,10,0"/>
                            <TextBlock Text="Param 2:" Grid.Row="0" Grid.Column="2"/>
                            <ComboBox x:Name="combo_param2" Grid.Row="0" Grid.Column="3" Margin="3,0,10,0"/>
                            <TextBlock Text="Param 3:" Grid.Row="0" Grid.Column="4"/>
                            <ComboBox x:Name="combo_param3" Grid.Row="0" Grid.Column="5" Margin="3,0,0,0"/>
                            <TextBlock Text="Param 4:" Grid.Row="1" Grid.Column="0" Margin="3,5,3,0"/>
                            <ComboBox x:Name="combo_param4" Grid.Row="1" Grid.Column="1" Margin="3,5,10,0"/>
                            <TextBlock Text="Param 5:" Grid.Row="1" Grid.Column="2" Margin="3,5,3,0"/>
                            <ComboBox x:Name="combo_param5" Grid.Row="1" Grid.Column="3" Margin="3,5,10,0"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Tokenization Delimiters">
                        <DockPanel>
                            <TextBlock Text="Characters:" DockPanel.Dock="Left" Margin="3,0,8,0"/>
                            <TextBox x:Name="txt_delimiters" FontSize="11" FontFamily="Courier New"
                                     ToolTip="Leave empty to use the default delimiters: -_/,|"/>
                        </DockPanel>
                    </GroupBox>
                    <GroupBox Header="Counter ({count} or {param6})">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Start" Grid.Column="0" Margin="3,0,8,0"/>
                            <TextBox x:Name="txt_counter_start" Grid.Column="1" FontSize="11" FontFamily="Courier New"/>
                            <TextBlock Text="Increment" Grid.Column="2" Margin="12,0,8,0"/>
                            <TextBox x:Name="txt_counter_increment" Grid.Column="3" FontSize="11" FontFamily="Courier New"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Tokenization (first selected row, otherwise first visible row)">
                        <TextBox x:Name="txt_tokenization" MinHeight="40" FontSize="10" FontFamily="Courier New"
                                 IsReadOnly="True" VerticalContentAlignment="Top"
                                 TextWrapping="Wrap" Background="WhiteSmoke"/>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Expander>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="LightGray" ShowsPreview="True"
                      ToolTip="Drag to resize More Settings and Preview.">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded, ElementName=more_settings}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>

        <GroupBox Grid.Row="3" Margin="0,3">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Preview"/>
                    <TextBlock x:Name="txt_filter_status" Foreground="DimGray"
                               MaxWidth="550" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Text, ElementName=txt_filter_summary}" Foreground="DimGray"
                               MaxWidth="200" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox.Header>
            <DataGrid x:Name="preview_grid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      GridLinesVisibility="All"
                      AlternatingRowBackground="WhiteSmoke">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                <Setter Property="Background" Value="#FFF4CC"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="ToolTip" Value="{Binding tooltip}"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Final" Binding="{Binding final}" Width="50"
                                            CanUserSort="False"/>
                    <DataGridTextColumn x:Name="col_sort_value" Binding="{Binding SortValue}"
                                        SortMemberPath="SortValue" Width="150" IsReadOnly="True"
                                        Visibility="Collapsed" Header="Sort Value"/>
                    <DataGridTextColumn x:Name="col_current" Binding="{Binding CurrentName}" SortMemberPath="CurrentName" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <StackPanel>
                                <StackPanel x:Name="current_header_sort_hint" Orientation="Horizontal"
                                            ToolTip="Click to sort ascending.">
                                    <TextBlock Text="Current Value"/>
                                    <TextBlock x:Name="current_sort_hint" Text=" &#x2195;"
                                               Foreground="#8A949E" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBox x:Name="txt_filter_current" Margin="3" Padding="3"
                                         ToolTip="Filter Current Value (contains, case-insensitive). Clear to show all."/>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="col_new" Binding="{Binding NewName}" Width="*"
                                        IsReadOnly="True" CanUserSort="False">
                        <DataGridTextColumn.Header>
                            <StackPanel>
                                <TextBlock Text="New Value"/>
                                <TextBox x:Name="txt_filter_new" Margin="3" Padding="3"
                                         ToolTip="Filter New Value (contains, case-insensitive). Clear to show all."/>
                            </StackPanel>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="ToolTip" Value="{Binding tooltip}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding final}" Value="True">
                                        <Setter Property="Background" Value="LightGreen"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button x:Name="btn_help" Content="Help" Width="80" DockPanel.Dock="Left"
                    Foreground="#492709" BorderBrush="#C96A12" FontWeight="Bold">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFD4A8" Offset="0"/>
                        <GradientStop Color="#F5A04C" Offset="0.45"/>
                        <GradientStop Color="#E67E22" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="btn_apply" Content="Apply Re-Value" Width="140"
                        ToolTipService.ShowOnDisabled="True">
                    <Button.Resources>
                        <TextBlock x:Key="NewValueFilterToolTip"><Run Text="Clear "/><Run Text="New Value" FontWeight="Bold"/><Run Text=" filter to apply"/></TextBlock>
                    </Button.Resources>
                </Button>
                <Button x:Name="btn_close" Content="Close" Width="80"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
