<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parameter Editor"
    Height="720" Width="1240"
    MinHeight="620" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="560" MinWidth="420"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"/>

            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 8">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0 0 6 0"/>
                        <TextBox x:Name="txtSearch"
                                 Width="160"
                                 Height="24"
                                 VerticalAlignment="Center"
                                 TextChanged="on_search_changed"
                                 ToolTip="Filter by name (or name and formula when Formula is ticked)"/>
                        <CheckBox x:Name="chkSearchFormula"
                                  Content="Formula"
                                  VerticalAlignment="Center"
                                  Margin="6 0 0 0"
                                  IsChecked="True"
                                  Checked="on_search_formula_toggled"
                                  Unchecked="on_search_formula_toggled"
                                  ToolTip="Also search inside formula text"/>
                        <TextBlock Text="Group:" VerticalAlignment="Center" Margin="12 0 6 0"/>
                        <ComboBox x:Name="cmbGroupFilter"
                                  Width="160"
                                  Height="24"
                                  VerticalAlignment="Center"
                                  SelectionChanged="on_group_filter_changed"
                                  ToolTip="Filter list by parameter group"/>
                    </StackPanel>

                    <DataGrid x:Name="lstParameters" Grid.Row="1" SelectionChanged="on_param_selected"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              BeginningEdit="on_value_beginning_edit"
                              CellEditEnding="on_value_cell_edit_ending"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False"
                              SelectionMode="Extended"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              RowHeaderWidth="0"
                              VirtualizingPanel.IsVirtualizing="False"
                              EnableRowVirtualization="False"
                              EnableColumnVirtualization="False"
                              ScrollViewer.CanContentScroll="False"
                              BorderThickness="0">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <StackPanel>
                                                        <ToggleButton x:Name="grpToggle" IsChecked="True" Cursor="Hand"
                                                                      PreviewMouseRightButtonUp="on_group_header_right_click"
                                                                      ToolTip="Right-click to preview sorting. Use Apply Sorting below to save."
                                                                      Background="#EEF1F5" BorderBrush="#D0D5DD"
                                                                      BorderThickness="0,0,0,1" Padding="0"
                                                                      HorizontalContentAlignment="Stretch">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            Padding="4,1">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Width="12" Foreground="#555555" FontSize="9"
                                                                           VerticalAlignment="Center" Text="&#x25BC;">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=grpToggle}" Value="False">
                                                                                    <Setter Property="Text" Value="&#x25B6;"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                                                           Foreground="#666666"/>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                        <ItemsPresenter>
                                                            <ItemsPresenter.Style>
                                                                <Style TargetType="ItemsPresenter">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=grpToggle}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ItemsPresenter.Style>
                                                        </ItemsPresenter>
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="160" Binding="{Binding Name}" IsReadOnly="True">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Name" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       ToolTip="Instance parameter names are dark blue and italic; type parameter names are normal."><Run FontStyle="Italic" Foreground="#0D47A1" Text="Inst"/><Run Text="/Type"/></TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="2,0"/>
                                        <Setter Property="FontStyle" Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InstanceTypeLabel}" Value="Instance">
                                                <Setter Property="FontStyle" Value="Italic"/>
                                                <Setter Property="Foreground" Value="#0D47A1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Group"     Width="110" Binding="{Binding GroupLabel}" Visibility="Collapsed" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Value" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Value}" Margin="3,0" VerticalAlignment="Center"
                                                   ToolTip="Double-click or press F2 to edit this value for the current family type."/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ContentControl Loaded="on_grid_value_editor_loaded"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Formula"   Width="200" Binding="{Binding Formula}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Inst/Type" Width="68"  Binding="{Binding InstanceTypeLabel}" Visibility="Collapsed" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 8 0 0">
                        <Button x:Name="btnReorderTop" Width="28" Height="24"
                                Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Margin="0 0 4 0" Click="on_reorder_top" IsEnabled="False" ToolTipService.ShowOnDisabled="True">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M 0,0 H 12 V 2 H 0 Z M 6,4 L 12,12 H 0 Z"/>
                        </Button>
                        <Button x:Name="btnReorderUp" Content="&#x25B2;" Width="28" Height="24"
                                Margin="0 0 4 0" Click="on_reorder_up" IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="btnReorderDown" Content="&#x25BC;" Width="28" Height="24"
                                Margin="0 0 4 0" Click="on_reorder_down" IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="btnReorderBottom" Width="28" Height="24"
                                Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Click="on_reorder_bottom" IsEnabled="False" ToolTipService.ShowOnDisabled="True">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M 0,10 H 12 V 12 H 0 Z M 0,0 H 12 L 6,8 Z"/>
                        </Button>
                        <Button x:Name="btnApplySorting" Content="Apply Sorting" Width="100" Height="24"
                                Margin="10 0 0 0" Click="on_apply_sorting" IsEnabled="False"
                                ToolTip="Save all pending sorting and manual reordering to Revit in one transaction."/>
                        <Button x:Name="btnResetSorting" Content="Reset Sorting" Width="100" Height="24"
                                Margin="4 0 0 0" Click="on_reset_sorting" IsEnabled="False"
                                ToolTip="Discard pending sorting and manual reordering and show the saved Revit order."/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Column="2" SelectionChanged="on_tab_selection_changed">

                <TabItem x:Name="tabBatchEdit" Header="Batch Edit" Visibility="Collapsed">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Selection summary -->
                        <Border Grid.Row="0" Background="#F0F4FF" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="3" Padding="8 6" Margin="0 0 0 10">
                            <TextBlock x:Name="txtBatchSummary"
                                       Text="Select multiple parameters from the list on the left."
                                       Foreground="#1565C0" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Toggle Instance/Type -->
                        <GroupBox Grid.Row="1" Header="Instance / Type" Margin="0 0 0 8" Padding="8 4 8 8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtBatchToggleInfo" Text="" VerticalAlignment="Center"
                                           Margin="0 0 10 0" Foreground="#5A5A5A" FontStyle="Italic"
                                           TextWrapping="Wrap" MaxWidth="320"/>
                                <Button x:Name="btnBatchToggle" Content="Toggle" Width="110" Height="28"
                                        Click="on_batch_toggle" IsEnabled="False"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Change Group -->
                        <GroupBox Grid.Row="2" Header="Change Group" Margin="0 0 0 8" Padding="8 4 8 8">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="cmbBatchGroup" Width="220" Height="26" Margin="0 0 8 0"/>
                                <Button x:Name="btnBatchChangeGroup" Content="Apply" Width="70" Height="26"
                                        Click="on_batch_change_group" IsEnabled="False"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Rename (Find / Replace) -->
                        <GroupBox Grid.Row="3" Header="Rename" Margin="0 0 0 8" Padding="8 4 8 8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Find:" VerticalAlignment="Center" Margin="0 0 6 0"/>
                                <TextBox x:Name="txtBatchFind" Grid.Row="0" Grid.Column="1" Height="26" Margin="0 0 10 0"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Replace:" VerticalAlignment="Center" Margin="0 0 6 0"/>
                                <TextBox x:Name="txtBatchReplace" Grid.Row="0" Grid.Column="3" Height="26" Margin="0 0 10 0"/>
                                <Button x:Name="btnBatchRename" Grid.Row="0" Grid.Column="4" Content="Apply Rename"
                                        Width="100" Height="26" Click="on_batch_prefix_suffix" IsEnabled="False"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Prefix:" VerticalAlignment="Center" Margin="0 0 6 0"/>
                                <TextBox x:Name="txtBatchPrefix" Grid.Row="2" Grid.Column="1" Height="26" Margin="0 0 10 0"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Suffix:" VerticalAlignment="Center" Margin="0 0 6 0"/>
                                <TextBox x:Name="txtBatchSuffix" Grid.Row="2" Grid.Column="3" Height="26" Margin="0 0 10 0"/>
                                <CheckBox x:Name="chkBatchRegex" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5"
                                          Content="Use regular expression (regex) for Find"
                                          VerticalAlignment="Center" IsChecked="False"/>
                            </Grid>
                        </GroupBox>

                        <!-- Duplicate / Delete -->
                        <GroupBox Grid.Row="4" Header="Other Actions" Margin="0 0 0 8" Padding="8 4 8 8">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnBatchDuplicate" Content="Duplicate All" Width="100" Height="28"
                                        Margin="0 0 8 0" Click="on_batch_duplicate" IsEnabled="False"/>
                                <Button x:Name="btnBatchDelete" Content="Delete All" Width="90" Height="28"
                                        Click="on_batch_delete" IsEnabled="False"
                                        Background="#FFEBEE" Foreground="#B71C1C" BorderBrush="#EF9A9A"/>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- TAB 1: Edit Existing Parameter                         -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <TabItem x:Name="tabEditExisting" Header="Edit Existing Parameter" IsSelected="True">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Parameter:" VerticalAlignment="Center" Margin="0 0 8 8"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0 0 0 8">
                            <TextBlock x:Name="txtSelectedParamName" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0 0 10 0"/>
                            <Border x:Name="borderToggleInstanceType"
                                    BorderBrush="#90CAF9" BorderThickness="1"
                                    Background="#E3F2FD"
                                    CornerRadius="11" Margin="0 0 12 0" VerticalAlignment="Center">
                                <Button x:Name="btnToggleInstanceType"
                                        Height="22" Padding="8 0" MinWidth="68"
                                        Click="on_toggle_instance_type"
                                        Foreground="#1565C0"
                                        FontSize="11"
                                        Cursor="Hand"
                                        ToolTip="Click to toggle between Instance and Type. Not available for shared parameters.">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Border>
                            <Button x:Name="btnDuplicateParameter" Content="Duplicate" Width="80" Height="26" Click="on_duplicate_parameter" Margin="0 0 6 0"/>
                            <Button x:Name="btnDeleteParameter" Content="Delete" Width="70" Height="26" Click="on_delete_parameter"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Group:" VerticalAlignment="Center" Margin="0 0 8 8"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0 0 0 8">
                            <ComboBox x:Name="cmbEditGroup" Width="210" Height="26" Margin="0 0 8 0"/>
                            <Button x:Name="btnApplyParamSettings" Content="Apply" Width="70" Height="26" Click="on_apply_param_settings"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Data Type:" VerticalAlignment="Center" Margin="0 0 8 8"/>
                        <TextBlock x:Name="txtSelectedParamDataType" Grid.Row="2" Grid.Column="1" Margin="0 0 0 8" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Current Value:" VerticalAlignment="Center" Margin="0 0 8 8"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0 0 0 8">
                            <ContentControl x:Name="currentValueEditor" Width="260" MinHeight="26" Margin="0 0 8 0"
                                            HorizontalContentAlignment="Stretch"
                                            ToolTip="Edit the value for the current family type, then click Apply Value."/>
                            <Button x:Name="btnApplyValue" Content="Apply Value" Width="95" Height="26" Click="on_apply_value"/>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Rename To:" VerticalAlignment="Center" Margin="0 0 8 8"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0 0 0 8">
                            <TextBox x:Name="txtRenameTo" Width="260" Height="26" Margin="0 0 8 0"/>
                            <Button x:Name="btnRenameParameter" Content="Rename" Width="90" Height="26" Click="on_rename_parameter"/>
                        </StackPanel>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Formula:" VerticalAlignment="Top" Margin="0 2 8 0"/>
                        <Grid Grid.Row="5" Grid.Column="1">
                            <RichTextBox x:Name="txtFormula"
                                     MinHeight="110"
                                     VerticalAlignment="Stretch"
                                     AcceptsReturn="False"
                                     AcceptsTab="False"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="on_formula_changed"
                                     SelectionChanged="on_formula_selection_changed"
                                     PreviewKeyDown="on_formula_keydown"
                                     PreviewTextInput="on_formula_preview_textinput"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     ToolTip="Type formula. Suggestions appear automatically from parameter names.">
                                <RichTextBox.Resources>
                                    <Style TargetType="Paragraph">
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                </RichTextBox.Resources>
                            </RichTextBox>
                            <Popup x:Name="popupSuggestions"
                                   PlacementTarget="{Binding ElementName=txtFormula}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True">
                                <Border BorderBrush="#B5B5B5" BorderThickness="1" Background="White" CornerRadius="2">
                                    <ListBox x:Name="lstSuggestions"
                                             Width="320"
                                             MaxHeight="190"
                                             MouseDoubleClick="on_suggestion_double_click"/>
                                </Border>
                            </Popup>
                        </Grid>

                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="txtFormulaBracketStatus" TextWrapping="Wrap" Foreground="#6A6A6A" Margin="0 4 0 0"
                                   Text=""/>

                        <TextBlock Grid.Row="7" Grid.Column="1" TextWrapping="Wrap" Foreground="#6A6A6A" Margin="0 4 0 0"
                                   Text="Autocomplete suggests parameter names while typing. Brackets and quotes auto-close."/>

                        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
                            <Button x:Name="btnClearFormula" Content="Clear Formula" Width="100" Height="28" Margin="0 0 8 0" Click="on_clear_formula"/>
                            <Button x:Name="btnApplyFormula" Content="Apply Formula" Width="110" Height="28" Click="on_apply_formula"/>
                        </StackPanel>
                        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 4 0 0">
                            <Button x:Name="btnAnalyzeFormula"
                                    Content="Beta - Apply &amp; Analyse Formula"
                                    Height="26"
                                    Padding="10 0"
                                    Click="on_analyze_formula"
                                    Background="#FFF3CD"
                                    Foreground="#856404"
                                    BorderBrush="#FFCA2C"
                                    FontStyle="Italic"
                                    ToolTip="Beta feature: Applies the formula to Revit (normalising spacing), then analyses and simplifies. Use with caution."/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- TAB 2: Create New Parameter                            -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <TabItem Header="Create New Parameter">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0 0 8 8"/>
                        <TextBox x:Name="txtNewName" Grid.Row="0" Grid.Column="1" Height="26" Margin="0 0 0 8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Discipline:" VerticalAlignment="Center" Margin="0 0 8 8"/>
                        <ComboBox x:Name="cmbNewDiscipline" Grid.Row="1" Grid.Column="1" Height="26" Margin="0 0 0 8"
                                  SelectionChanged="on_new_discipline_changed"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Type of Parameter:" VerticalAlignment="Center" Margin="0 0 8 8"/>
                        <ComboBox x:Name="cmbNewType" Grid.Row="2" Grid.Column="1" Height="26" Margin="0 0 0 8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Group:" VerticalAlignment="Center" Margin="0 0 8 8"/>
                        <ComboBox x:Name="cmbNewGroup" Grid.Row="3" Grid.Column="1" Height="26" Margin="0 0 0 8"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Options:" VerticalAlignment="Center" Margin="0 0 8 8"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0 0 0 8">
                            <CheckBox x:Name="chkNewInstance" Content="Instance parameter" IsChecked="True" Margin="0 0 16 0"/>
                            <CheckBox x:Name="chkNewShared" Content="Shared parameter" Checked="on_new_shared_changed" Unchecked="on_new_shared_changed"/>
                        </StackPanel>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Shared definition:" VerticalAlignment="Center" Margin="0 0 8 8"/>
                        <ComboBox x:Name="cmbSharedDefinition" Grid.Row="5" Grid.Column="1" Height="26" Margin="0 0 0 8" SelectionChanged="on_shared_def_selected"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Initial value:" VerticalAlignment="Center" Margin="0 0 8 8"/>
                        <TextBox x:Name="txtNewInitialValue" Grid.Row="6" Grid.Column="1" Height="26" Margin="0 0 0 8" ToolTip="Optional. Applied to current family type right after creation."/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Initial formula:" VerticalAlignment="Top" Margin="0 2 8 0"/>
                        <Grid Grid.Row="7" Grid.Column="1" Margin="0 0 0 8">
                            <RichTextBox x:Name="txtNewFormula"
                                     MinHeight="60"
                                     VerticalAlignment="Stretch"
                                     AcceptsReturn="False"
                                     AcceptsTab="False"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="on_new_formula_changed"
                                     SelectionChanged="on_new_formula_selection_changed"
                                     PreviewKeyDown="on_new_formula_keydown"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     ToolTip="Type formula. Suggestions appear automatically from parameter names.">
                                <RichTextBox.Resources>
                                    <Style TargetType="Paragraph">
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                </RichTextBox.Resources>
                            </RichTextBox>
                            <Popup x:Name="popupNewSuggestions"
                                   PlacementTarget="{Binding ElementName=txtNewFormula}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True">
                                <Border BorderBrush="#B5B5B5" BorderThickness="1" Background="White" CornerRadius="2">
                                    <ListBox x:Name="lstNewSuggestions"
                                             Width="320"
                                             MaxHeight="190"
                                             MouseDoubleClick="on_new_suggestion_double_click"/>
                                </Border>
                            </Popup>
                        </Grid>

                        <TextBlock x:Name="txtNewFormulaBracketStatus" Grid.Row="8" Grid.Column="1" TextWrapping="Wrap" Foreground="#6A6A6A" Margin="0 4 0 0"
                                   Text=""/>

                        <TextBlock Grid.Row="9" Grid.Column="1" Foreground="#6A6A6A" TextWrapping="Wrap" Margin="0 4 0 0"
                                   Text="Initial value supports number, integer, yes/no, string, and name lookup for Material/ElementId parameters. Autocomplete suggests parameter names in the formula."/>

                        <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
                            <Button Content="Clear Formula" Width="100" Height="30" Margin="0 0 8 0" Click="on_clear_new_formula"/>
                            <Button x:Name="btnCreateParameter" Content="Create Parameter" Width="130" Height="30" Click="on_create_parameter"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- TAB 6: Import Parameters                               -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <TabItem x:Name="tabImport" Header="Import">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Source family picker -->
                        <GroupBox Grid.Row="0" Header="Source Family" Margin="0 0 0 8" Padding="8 4 8 8">
                            <DockPanel>
                                <Button x:Name="btnImportRefresh" DockPanel.Dock="Right" Content="Refresh"
                                        Width="70" Height="26" Margin="6 0 0 0"
                                        Click="on_import_refresh"/>
                                <ComboBox x:Name="cmbImportSource" Height="26"
                                          SelectionChanged="on_import_source_changed"/>
                            </DockPanel>
                        </GroupBox>

                        <!-- Sub-tabs: Parameters / Nested Families / Object Styles -->
                        <TabControl x:Name="importSubTabs" Grid.Row="1" Margin="0 0 0 8"
                                    SelectionChanged="on_import_subtab_changed">

                            <!-- Parameters sub-tab -->
                            <TabItem Header="Parameters">
                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0 0 0 4">
                                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0 0 6 0"
                                                   DockPanel.Dock="Left"/>
                                        <CheckBox x:Name="chkImportHideNonTransferable"
                                                  Content="Hide non-transferable"
                                                  VerticalAlignment="Center" Margin="6 0 0 0"
                                                  IsChecked="True" DockPanel.Dock="Right"
                                                  Checked="on_import_filter_changed"
                                                  Unchecked="on_import_filter_changed"/>
                                        <TextBox x:Name="txtImportSearch" Height="24"
                                                 TextChanged="on_import_search_changed"/>
                                    </DockPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 4">
                                        <Button Content="Select All"  Width="80" Height="22" Margin="0 0 6 0"
                                                Click="on_import_params_select_all"/>
                                        <Button Content="Select None" Width="80" Height="22"
                                                Click="on_import_params_select_none"/>
                                    </StackPanel>
                                    <ListView x:Name="lstImportParams" Grid.Row="2"
                                              SelectionMode="Extended" BorderThickness="1">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Width="32">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Width="18"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Name"      Width="160" DisplayMemberBinding="{Binding Name}"/>
                                                <GridViewColumn Header="Group"     Width="110" DisplayMemberBinding="{Binding GroupLabel}"/>
                                                <GridViewColumn Header="Inst/Type" Width="68"  DisplayMemberBinding="{Binding InstanceTypeLabel}"/>
                                                <GridViewColumn Header="Shared"    Width="46"  DisplayMemberBinding="{Binding SharedLabel}"/>
                                                <GridViewColumn Header="Formula"   Width="140" DisplayMemberBinding="{Binding Formula}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock x:Name="txtImportParamsCount" Grid.Row="3"
                                               Margin="0 4 0 0" Foreground="#5A5A5A" FontStyle="Italic"/>
                                </Grid>
                            </TabItem>

                            <!-- Nested Families sub-tab -->
                            <TabItem Header="Nested Families">
                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 4">
                                        <CheckBox x:Name="chkImportNestedMissingOnly" Content="Load missing only"
                                                  IsChecked="True" Margin="0 0 12 0" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="chkImportNestedReloadExisting" Content="Reload existing"
                                                  IsChecked="False" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 4">
                                        <Button Content="Select All"  Width="80" Height="22" Margin="0 0 6 0"
                                                Click="on_import_nested_select_all"/>
                                        <Button Content="Select None" Width="80" Height="22"
                                                Click="on_import_nested_select_none"/>
                                    </StackPanel>
                                    <ListView x:Name="lstImportNested" Grid.Row="2"
                                              SelectionMode="Extended" BorderThickness="1">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Width="32">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Width="18"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Name"     Width="200" DisplayMemberBinding="{Binding Name}"/>
                                                <GridViewColumn Header="Category" Width="140" DisplayMemberBinding="{Binding CategoryName}"/>
                                                <GridViewColumn Header="Status"   Width="80"  DisplayMemberBinding="{Binding Status}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </TabItem>

                            <!-- Object Styles sub-tab -->
                            <TabItem Header="Object Styles">
                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0 0 0 4">
                                        <TextBlock Text="Parent:" VerticalAlignment="Center" Margin="0 0 6 0"
                                                   DockPanel.Dock="Left"/>
                                        <ComboBox x:Name="cmbImportStylesCategory" Height="24"
                                                  SelectionChanged="on_import_style_category_changed"/>
                                    </DockPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 4">
                                        <CheckBox x:Name="chkImportStylesModel" Content="Model"
                                                  IsChecked="True" Margin="0 0 10 0"
                                                  Checked="on_import_filter_changed"
                                                  Unchecked="on_import_filter_changed"/>
                                        <CheckBox x:Name="chkImportStylesAnnotation" Content="Annotation"
                                                  IsChecked="True" Margin="0 0 10 0"
                                                  Checked="on_import_filter_changed"
                                                  Unchecked="on_import_filter_changed"/>
                                        <CheckBox x:Name="chkImportStylesImported" Content="Import"
                                                  IsChecked="False"
                                                  Checked="on_import_filter_changed"
                                                  Unchecked="on_import_filter_changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 0 0 4">
                                        <Button Content="Select All"  Width="80" Height="22" Margin="0 0 6 0"
                                                Click="on_import_styles_select_all"/>
                                        <Button Content="Select None" Width="80" Height="22"
                                                Click="on_import_styles_select_none"/>
                                    </StackPanel>
                                    <ListView x:Name="lstImportStyles" Grid.Row="3"
                                              SelectionMode="Extended" BorderThickness="1">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Width="32">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Width="18"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Parent"   Width="140" DisplayMemberBinding="{Binding ParentCategory}"/>
                                                <GridViewColumn Header="Name"     Width="160" DisplayMemberBinding="{Binding Name}"/>
                                                <GridViewColumn Header="Type"     Width="80"  DisplayMemberBinding="{Binding StyleType}"/>
                                                <GridViewColumn Header="Status"   Width="80"  DisplayMemberBinding="{Binding Status}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </TabItem>

                        </TabControl>

                        <!-- Options -->
                        <GroupBox Grid.Row="2" Header="Options" Padding="8 4 8 8" Margin="0 0 0 8">
                            <WrapPanel Orientation="Horizontal">
                                <CheckBox x:Name="chkImportTransferFormulas" Content="Transfer formulas"
                                          IsChecked="True"  Margin="0 0 16 4"/>
                                <CheckBox x:Name="chkImportTransferValues"   Content="Transfer values"
                                          IsChecked="True"  Margin="0 0 16 4"/>
                                <CheckBox x:Name="chkImportOverwriteValues"  Content="Overwrite existing values"
                                          IsChecked="False" Margin="0 0 16 4"/>
                                <CheckBox x:Name="chkImportCreateMaterials"  Content="Create missing materials"
                                          IsChecked="False" Margin="0 0 0 4"/>
                            </WrapPanel>
                        </GroupBox>

                        <!-- Import button -->
                        <Button x:Name="btnImportExecute" Grid.Row="3"
                                Content="Import Selected" Height="32" Width="160"
                                HorizontalAlignment="Right"
                                Click="on_import_execute" IsEnabled="False"
                                Background="#1565C0" Foreground="White"
                                BorderBrush="#0D47A1" FontWeight="SemiBold"/>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>

        <Border Grid.Row="1" Background="#F7F7F7" CornerRadius="3" Padding="8" Margin="0 10 0 0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Help" Width="88" Height="28" Margin="10 0 0 0" Click="on_help"/>
                    <Button Content="Close" Width="88" Height="28" Margin="10 0 0 0" Click="on_close"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock x:Name="txtStatus" Grid.Row="2" Foreground="#2A2A2A" Text="Ready."
                   TextWrapping="Wrap" Margin="8 6 8 0"/>
    </Grid>
</Window>
