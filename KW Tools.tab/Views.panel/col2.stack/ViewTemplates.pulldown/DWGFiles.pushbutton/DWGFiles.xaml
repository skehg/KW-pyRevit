<Window x:Class="pyRevit.DWGFiles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DWG Visibility" Width="920" Height="620" ResizeMode="CanResize" MinWidth="820" MinHeight="540" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10" Background="#FAFAFA">
            <StackPanel>
                <TextBlock Text="Selected Views and View Templates" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="TargetSummaryText" TextWrapping="Wrap" Foreground="#444444"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Search DWG:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="SearchBox" Width="320" Height="24" ToolTip="Filter DWGs by name."/>
            <TextBlock Text="Tip: edit the checkbox to toggle a single DWG, or use the bulk buttons below." VerticalAlignment="Center" Foreground="Gray" Margin="14,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <WrapPanel>
                <Button x:Name="SetSelectedOnBtn" Content="On Selected" MinWidth="105" Height="26" Margin="0,0,6,0"/>
                <Button x:Name="SetSelectedOffBtn" Content="Off Selected" MinWidth="105" Height="26" Margin="0,0,16,0"/>
                <Button x:Name="SetAllOnBtn" Content="On All" MinWidth="90" Height="26" Margin="0,0,6,0"/>
                <Button x:Name="SetAllOffBtn" Content="Off All" MinWidth="90" Height="26"/>
            </WrapPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="Use Ctrl/Shift for multi-select. Mixed state means the selected views/templates do not currently match." Foreground="Gray" Margin="0,0,0,8"/>

        <DataGrid Grid.Row="4" x:Name="DwgGrid" AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="FullRow"
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="DWG" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Current State" Binding="{Binding CurrentStateText}" Width="120" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="On/Off" Binding="{Binding IsVisible, Mode=TwoWay}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,5,0" x:Name="CancelBtn"/>
            <Button Content="Apply" Width="80" x:Name="ApplyBtn"/>
        </StackPanel>
    </Grid>
</Window>