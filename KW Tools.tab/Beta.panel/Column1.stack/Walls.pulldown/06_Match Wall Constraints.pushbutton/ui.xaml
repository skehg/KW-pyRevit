<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wall Match: Constraints"
        Height="500" Width="560"
        MinHeight="500" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Configure mapping, offset, and optional level overrides."
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <GroupBox Grid.Row="1" Header="Mapping" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <CheckBox x:Name="chkEnableMapping" Content="Enable Mapping" IsChecked="True" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Preset" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="cmbPreset" Height="28"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Match Offset" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Offset in project units (+/-)" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="txtMatchOffset" Height="28" Text="0" HorizontalContentAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="0 means no offset" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#666"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Change Wall Constraints (Optional)" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" x:Name="chkOverrideBase" Content="Override Base Constraint"/>
                    <ComboBox Grid.Column="1" x:Name="cmbBaseLevel" Height="28" IsEnabled="False"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" x:Name="chkOverrideTop" Content="Override Top Constraint"/>
                    <ComboBox Grid.Column="1" x:Name="cmbTopLevel" Height="28" IsEnabled="False"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <TextBlock Grid.Row="4"
                   Text="Session memory: this dialog remembers your last choices during the current Revit session."
                   Foreground="#666"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnStart" Content="Start" Width="100" Height="30" Margin="0,0,8,0" IsDefault="True" Click="on_start"/>
            <Button x:Name="btnCancel" Content="Cancel" Width="100" Height="30" IsCancel="True" Click="on_cancel"/>
        </StackPanel>
    </Grid>
</Window>
