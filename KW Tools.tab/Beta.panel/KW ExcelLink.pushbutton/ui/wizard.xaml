<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="KW ExcelLink — Parameter Selection"
    Height="620"
    Width="940"
    MinHeight="480"
    MinWidth="760"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="False"
    Background="#FFF6F7F9">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Step 4 of 5 — Parameter Selection"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#202938"/>
            <TextBlock x:Name="lblCategory"
                       Margin="0,7,0,0"
                       FontSize="13"
                       Foreground="#4B5563"/>
            <TextBlock x:Name="lblProgress"
                       Margin="0,5,0,0"
                       FontSize="12"
                       Foreground="#1769AA"/>
            <TextBlock x:Name="lblMode"
                       Margin="0,3,0,10"
                       Foreground="#4B5563"/>
        </StackPanel>
        <TextBlock Grid.Row="1"
                   Text="Filter by usage or search by name. Select several fields and add them in one step; selected columns stay in the order shown."
                   Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Foreground="#374151"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top"
                           Text="Available parameters"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"
                           Foreground="#374151"/>
                <ComboBox x:Name="cboAvailability"
                          DockPanel.Dock="Top"
                          MinHeight="27"
                          Margin="0,0,0,7"
                          SelectedIndex="0"
                          ToolTip="Filter by whether parameters are available on types, instances, or both">
                    <ComboBoxItem Content="All parameters"/>
                    <ComboBoxItem Content="Type parameters"/>
                    <ComboBoxItem Content="Instance parameters"/>
                    <ComboBoxItem Content="Mixed-use parameters"/>
                </ComboBox>
                <TextBox x:Name="txtSearch"
                         DockPanel.Dock="Top"
                         MinHeight="26"
                         Margin="0,0,0,7"
                         Padding="5,2"
                         VerticalContentAlignment="Center"
                         ToolTip="Filter available parameters by name"
                         TextChanged="on_search_changed"/>
                <ListBox x:Name="lstAvailable"
                         SelectionMode="Extended"
                         BorderBrush="#CBD5E1"
                         Background="White"/>
            </DockPanel>
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="12,0">
                <Button Content="→ Add" Width="82" Height="32" Margin="0,0,0,8"
                        ToolTip="Add selected available parameters"
                        Click="on_add"/>
                <Button Content="← Remove" Width="82" Height="32"
                        ToolTip="Remove selected datagrid parameters"
                        Click="on_remove"/>
            </StackPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top"
                           Text="Datagrid columns (top to bottom)"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"
                           Foreground="#374151"/>
                <TextBlock x:Name="lblCounts"
                           DockPanel.Dock="Bottom"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="#566273"/>
                <ListBox x:Name="lstSelected"
                         SelectionMode="Extended"
                         BorderBrush="#CBD5E1"
                         Background="White"/>
            </DockPanel>
            <StackPanel Grid.Column="3"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                <Button Content="↑" Width="38" Height="32" Margin="0,0,0,8"
                        ToolTip="Move selected columns up"
                        Click="on_move_up"/>
                <Button Content="↓" Width="38" Height="32"
                        ToolTip="Move selected columns down"
                        Click="on_move_down"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Width="90" Height="31" Margin="0,0,8,0"
                    Click="on_back" AutomationProperties.Name="Back">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M8 0 L0 5 L8 10 Z" Width="8" Height="10"
                          Stretch="Fill" VerticalAlignment="Center" Margin="0,0,6,0"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text="Back" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Content="Cancel" Width="90" Height="31" Margin="0,0,8,0"
                    Click="on_cancel"/>
            <Button x:Name="btnContinue" Content="Open Grid" Width="110" Height="31"
                    Click="on_continue"/>
        </StackPanel>
    </Grid>
</Window>
