<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="NeutralSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Padding" Value="3,0"/>
        <Setter Property="Background" Value="#777777"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="switch_left_label" Text="{TemplateBinding Content}"
                                   Margin="0,0,4,0" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Border x:Name="switch_border" CornerRadius="4"
                            BorderThickness="1" BorderBrush="Transparent"
                            Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Border x:Name="switch_track" Width="36" Height="20"
                                    CornerRadius="10" Background="{TemplateBinding Background}">
                                <Ellipse x:Name="switch_thumb" Width="16" Height="16"
                                         Fill="White" Margin="2" HorizontalAlignment="Left"/>
                            </Border>
                        </Border>
                        <TextBlock x:Name="switch_right_label" Text="{TemplateBinding Tag}"
                                   Margin="4,0,0,0" VerticalAlignment="Center" FontWeight="Normal"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="">
                            <Setter TargetName="switch_left_label" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="switch_left_label" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="switch_right_label" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="switch_thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="switch_left_label" Property="FontWeight" Value="Normal"/>
                            <Setter TargetName="switch_right_label" Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger SourceName="switch_border" Property="IsMouseOver" Value="True">
                            <Setter TargetName="switch_border" Property="Background" Value="#E8EEF4"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="switch_border" Property="BorderBrush" Value="#0078D4"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="switch_border" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="switch_left_label" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="switch_right_label" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <LinearGradientBrush x:Key="ButtonRaisedFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F0F2F4" Offset="0.45"/>
        <GradientStop Color="#D9DFE5" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonHoverFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#E4F1FC" Offset="0.45"/>
        <GradientStop Color="#C7DFF1" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonPressedFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B9CAD8" Offset="0"/>
        <GradientStop Color="#E4EDF4" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="RaisedButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonRaisedFill}"/>
        <Setter Property="Foreground" Value="#253746"/>
        <Setter Property="BorderBrush" Value="#8795A3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="button_surface">
                        <Border x:Name="button_face" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect Color="#334155" BlurRadius="3"
                                                  ShadowDepth="1" Direction="270" Opacity="0.25"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="button_highlight" CornerRadius="5" Margin="1"
                                BorderThickness="0,1,0,1" IsHitTestVisible="False">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#E6FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.45"/>
                                    <GradientStop Color="#40536475" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>
                        <Border Padding="{TemplateBinding Padding}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter x:Name="button_content" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="button_face" Property="Background" Value="{StaticResource ButtonHoverFill}"/>
                            <Setter TargetName="button_face" Property="BorderBrush" Value="#3979AB"/>
                        </Trigger>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="button_face" Property="BorderBrush" Value="#0078D4"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="button_face" Property="BorderBrush" Value="#0078D4"/>
                            <Setter TargetName="button_highlight" Property="BorderBrush" Value="#0078D4"/>
                            <Setter TargetName="button_highlight" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="button_face" Property="Background" Value="{StaticResource ButtonPressedFill}"/>
                            <Setter TargetName="button_face" Property="Effect" Value="{x:Null}"/>
                            <Setter TargetName="button_highlight" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="button_content" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="button_surface" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="button_face" Property="Background" Value="#E5E7EB"/>
                            <Setter TargetName="button_face" Property="BorderBrush" Value="#AAB2BB"/>
                            <Setter TargetName="button_face" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
