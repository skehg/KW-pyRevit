<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Categories and Families" Width="900" Height="650"
        MinWidth="720" MinHeight="460" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ButtonStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style TargetType="Button" BasedOn="{StaticResource RaisedButtonStyle}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="3"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="3,3,3,8">
            <TextBlock Text="Scope:"/>
            <TextBlock x:Name="scope_view_label" Text="Current View" Margin="8,3,4,3"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=scope_toggle}" Value="False">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ToggleButton x:Name="scope_toggle" IsChecked="False"
                          AutomationProperties.Name="Selection scope: Current View or Entire Project"
                          VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource NeutralSwitchStyle}">
                        <Setter Property="Content" Value=""/>
                        <Setter Property="ToolTip" Value="Scope: Current View. Click to switch to Entire Project."/>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="ToolTip" Value="Scope: Entire Project. Click to switch to Current View."/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <TextBlock x:Name="scope_project_label" Text="Entire Project"
                       Margin="4,3,3,3" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=scope_toggle}" Value="True">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Categories - check to include; highlight to choose families" TextWrapping="Wrap"/>
                <TextBox x:Name="search_categories" Grid.Row="1" ToolTip="Search categories"/>
                <ListBox x:Name="category_list" Grid.Row="2"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="family_heading" Text="Families - highlight a category first" TextWrapping="Wrap"/>
                <StackPanel x:Name="family_modes" Grid.Row="1" Orientation="Horizontal" Margin="3,5">
                    <ToggleButton x:Name="family_toggle" IsChecked="False"
                                  AutomationProperties.Name="Family inclusion: All families or Selected families only">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource NeutralSwitchStyle}">
                                <Setter Property="Content" Value="All families"/>
                                <Setter Property="Tag" Value="Selected families only"/>
                                <Setter Property="ToolTip" Value="Including all families. Click to choose Selected families only."/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="ToolTip" Value="Including selected families only. Click to include All families."/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </StackPanel>
                <TextBox x:Name="search_families" Grid.Row="2" ToolTip="Search families"/>
                <ListBox x:Name="family_list" Grid.Row="3"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Grid>
        </Grid>
        <TextBlock x:Name="selection_summary" Grid.Row="2" MaxHeight="70"
                   TextWrapping="Wrap" Foreground="DimGray"/>
        <StackPanel Grid.Row="3">
            <TextBlock x:Name="selection_status" TextWrapping="Wrap" FontWeight="SemiBold"/>
            <TextBlock Text="Current View uses Revit's view collection, not the zoomed screen area. Linked documents are excluded."
                       TextWrapping="Wrap" Foreground="DimGray"/>
            <TextBlock Text="Type mode warning: modifying a type can affect every instance of that type, including instances outside this scope."
                       TextWrapping="Wrap" Foreground="DarkOrange"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="cancel_selection" Content="Cancel" MinWidth="80" IsCancel="True"/>
            <Button x:Name="use_selection" Content="Use Selection" MinWidth="110" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
