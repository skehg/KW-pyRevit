<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Parameter Filters" Width="920" Height="680"
        MinWidth="780" MinHeight="460" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Combine read-only parameter conditions. Numeric values use displayed project units; enter decimal numbers without units or thousands separators."
                   TextWrapping="Wrap" Margin="3,0,3,8"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel x:Name="rules_panel"/>
        </ScrollViewer>
        <Expander x:Name="advanced" Grid.Row="2" Header="Advanced expression (optional)" Margin="3,8,3,3">
            <StackPanel>
                <TextBlock Text="AND(condition, ...), OR(condition, ...), NOT(condition). Parameters: [Name]. Text: &quot;value&quot;. Numbers: 1200.5."
                           TextWrapping="Wrap" Margin="3"/>
                <TextBox x:Name="expression_text" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="120" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
            </StackPanel>
        </Expander>
        <TextBlock x:Name="validation_status" Grid.Row="3" TextWrapping="Wrap" Margin="3,6"/>
        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button x:Name="clear_rules" Content="Clear All" DockPanel.Dock="Left"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="use_filters" Content="Use Filters" MinWidth="100"/>
                <Button x:Name="cancel_editor" Content="Cancel" MinWidth="80" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
