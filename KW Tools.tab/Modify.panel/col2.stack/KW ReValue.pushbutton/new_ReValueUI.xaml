<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Koala ReValue Studio"
        Height="860" Width="1200" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#EEF3F7"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="NavyBrush" Color="#17233A"/>
            <SolidColorBrush x:Key="NavyMutedBrush" Color="#243451"/>
            <SolidColorBrush x:Key="BlueBrush" Color="#3498CF"/>
            <SolidColorBrush x:Key="BlueDarkBrush" Color="#084C73"/>
            <SolidColorBrush x:Key="BlueSoftBrush" Color="#EAF4FA"/>
            <SolidColorBrush x:Key="OrangeBrush" Color="#F58220"/>
            <SolidColorBrush x:Key="OrangeSoftBrush" Color="#FFF1E5"/>
            <SolidColorBrush x:Key="OrangeDarkBrush" Color="#B95600"/>
            <SolidColorBrush x:Key="CanvasBrush" Color="#EEF3F7"/>
            <SolidColorBrush x:Key="LineBrush" Color="#D6E0E8"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#5F7181"/>
            <SolidColorBrush x:Key="GreenBrush" Color="#2F7D49"/>
            <SolidColorBrush x:Key="GreenSoftBrush" Color="#E7F4EC"/>

            <Style x:Key="EyebrowStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,0,0,3"/>
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>
            <Style x:Key="SidebarStepStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,4"/>
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="18"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="SelectionBrush" Value="#B9DEF2"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="Padding" Value="18,8"/>
                <Setter Property="Background" Value="{StaticResource OrangeBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#C86400"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="button_surface">
                                <Border x:Name="button_face" CornerRadius="6"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#6C390F" BlurRadius="7"
                                                                      ShadowDepth="1" Direction="270" Opacity="0.20"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}"
                                                             Value="False">
                                                    <Setter Property="Effect" Value="{x:Null}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="button_face" Property="Background" Value="#E56B00"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="button_face" Property="Background" Value="{StaticResource OrangeDarkBrush}"/>
                                    <Setter TargetName="button_face" Property="Effect" Value="{x:Null}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="button_face" Property="BorderBrush" Value="#17233A"/>
                                    <Setter TargetName="button_face" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="button_surface" Property="Opacity" Value="0.48"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RaisedButtonStyle}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource BlueDarkBrush}"/>
            </Style>
            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Padding" Value="9,6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="face" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="face" Property="Background" Value="#EAF4FA"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="face" Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="face" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="TokenDirectionStyle" TargetType="RadioButton">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="52"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="Foreground" Value="{StaticResource BlueDarkBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="segment" Background="{StaticResource BlueSoftBrush}"
                                    BorderBrush="#9CCCE3" BorderThickness="1" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="segment" Property="Background" Value="#D8EEF9"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="segment" Property="Background" Value="{StaticResource BlueBrush}"/>
                                    <Setter TargetName="segment" Property="BorderBrush" Value="{StaticResource BlueDarkBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="segment" Property="BorderBrush" Value="{StaticResource BlueDarkBrush}"/>
                                    <Setter TargetName="segment" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="segment" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="TokenPillStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BlueSoftBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource BlueDarkBrush}"/>
                <Setter Property="BorderBrush" Value="#B9D7E8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="7,3"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="pill" CornerRadius="14"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="pill" Property="Background" Value="#D8EEF9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="pill" Property="Background" Value="#C3E2F2"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="pill" Property="BorderBrush" Value="{StaticResource BlueDarkBrush}"/>
                                    <Setter TargetName="pill" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="pill" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource NavyBrush}">
            <Grid Margin="22,24,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="12" Background="White">
                        <Ellipse Width="17" Height="17" Fill="{StaticResource BlueBrush}"/>
                    </Border>
                    <StackPanel Margin="11,2,0,0">
                        <TextBlock Text="KoalaBIM" Foreground="White" FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Text="ReValue Studio" Foreground="#A9C2D4"
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="WORKFLOW" Foreground="#85A4BA"
                           FontSize="10" FontWeight="Bold" Margin="2,32,0,9"/>

                <StackPanel Grid.Row="2">
                    <Border Style="{StaticResource SidebarStepStyle}" Background="{StaticResource NavyMutedBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource OrangeBrush}">
                                <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource NavyBrush}" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                <TextBlock Text="Choose scope" Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock Text="Mode, source and filters" Foreground="#9EB4C3"
                                           FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SidebarStepStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="#41506A">
                                <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                <TextBlock Text="Build recipe" Foreground="#D5DEE7" FontWeight="SemiBold"/>
                                <TextBlock Text="Tokens, rules and order" Foreground="#8FA9BC"
                                           FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SidebarStepStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="#41506A">
                                <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                <TextBlock Text="Review &amp; apply" Foreground="#D5DEE7" FontWeight="SemiBold"/>
                                <TextBlock Text="Polish, preview, commit" Foreground="#8FA9BC"
                                           FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Height="1" Background="#30415B" Margin="0,22"/>
                    <TextBlock Text="SAFE BY DESIGN" Foreground="#85A4BA" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="Nothing changes in Revit until you press Apply. Review every proposed value first."
                               Foreground="#D0DBE5" FontSize="11" LineHeight="17"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>

                <Border Grid.Row="3" Background="{StaticResource NavyMutedBrush}"
                        CornerRadius="9" Padding="13,10">
                    <TextBlock Text="?  Help &amp; examples" Foreground="White"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="78"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="KOALABIM / REVALUE" Style="{StaticResource EyebrowStyle}"/>
                        <TextBlock Text="Make names make sense." Style="{StaticResource SectionTitleStyle}" FontSize="23"/>
                        <TextBlock Text="Build a naming recipe once. Preview every result before applying it."
                                   Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource BlueSoftBrush}" CornerRadius="15"
                                Padding="13,6" Margin="0,0,8,0">
                            <TextBlock Text="LIVE PREVIEW" Foreground="{StaticResource BlueDarkBrush}"
                                       FontWeight="SemiBold" FontSize="11"/>
                        </Border>
                        <Border Background="{StaticResource OrangeSoftBrush}" CornerRadius="15"
                                Padding="13,6">
                            <TextBlock Text="NOT APPLIED" Foreground="{StaticResource OrangeDarkBrush}"
                                       FontWeight="SemiBold" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" MinWidth="440"/>
                    <ColumnDefinition Width="*" MinWidth="300" MaxWidth="360"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="left_editor_scroll" Grid.Column="0" Margin="0,0,14,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="250"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="01  SCOPE" Style="{StaticResource EyebrowStyle}"/>
                                    <TextBlock Text="Choose what to revalue" Style="{StaticResource SectionTitleStyle}"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0">
                                    <TextBlock x:Name="txt_filter_summary"
                                               Text="No parameter filters" Foreground="{StaticResource MutedBrush}"
                                               MaxWidth="190" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Button x:Name="btn_clear_filters" Content="Clear filters"
                                                Style="{StaticResource QuietButtonStyle}" Margin="0,0,5,0"
                                                ToolTip="Clear all parameter filter rules."/>
                                        <Button x:Name="btn_edit_filters" Content="Edit filters"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Edit independent parameter filter rules."/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="mode_switch_host" Grid.Column="0"
                                            MinWidth="150" Margin="0,0,10,0">
                                    <TextBlock Text="MODE" Style="{StaticResource FieldLabelStyle}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton x:Name="btn_mode" IsChecked="False"
                                                      AutomationProperties.Name="Mode: Type or Instance">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource NeutralSwitchStyle}">
                                                    <Setter Property="Content" Value="Type"/>
                                                    <Setter Property="Tag" Value="Instance"/>
                                                    <Setter Property="ToolTip" Value="Type mode: works on element types. Click to switch to Instance mode."/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="ToolTip" Value="Instance mode: works directly on selected instances, such as views and walls. Click to switch to Type mode."/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="SOURCE PARAMETER" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="combo_orig_param"
                                              ToolTip="The bracketed Default option uses the system name shown for this selection and mode. Select a parameter to use its value instead."/>
                                </StackPanel>
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="SORT BY" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="combo_sort_by"
                                                  ToolTip="Order the preview rows. The counter and sequences number rows in this order. Click the Current Value header to sort by Current Value."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="DIRECTION" Style="{StaticResource FieldLabelStyle}"/>
                                        <ToggleButton x:Name="btn_sort_direction"
                                                      AutomationProperties.Name="Sort direction: Ascending or Descending">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource NeutralSwitchStyle}">
                                                    <Setter Property="Content" Value="Asc"/>
                                                    <Setter Property="Tag" Value="Desc"/>
                                                    <Setter Property="ToolTip" Value="Sorted ascending. Click to sort descending. Blank values always sort last."/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="ToolTip" Value="Sorted descending. Click to sort ascending. Blank values always sort last."/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text=" " Style="{StaticResource FieldLabelStyle}"/>
                                        <Button x:Name="btn_clear_sort" Content="X" Width="34" Height="36"
                                                Style="{StaticResource QuietButtonStyle}"
                                                ToolTip="Clear sort order (restore selection order)."
                                                AutomationProperties.Name="Clear sort order"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="02  RECIPE" Style="{StaticResource EyebrowStyle}"/>
                                    <TextBlock Text="Build the new value" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Drag parts into order or add a rule to transform them."
                                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ToggleButton x:Name="btn_use_orig" DockPanel.Dock="Right"
                                              Margin="8,3,0,0" IsChecked="False"
                                              AutomationProperties.Name="Composition: Rules or Source">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource NeutralSwitchStyle}">
                                            <Setter Property="Content" Value="Rules"/>
                                            <Setter Property="Tag" Value="Source"/>
                                            <Setter Property="ToolTip" Value="Using ordered token rules. Click to use the complete Original Source."/>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="#287D46"/>
                                                    <Setter Property="ToolTip" Value="Using Original Source. Click to restore the previous token rules."/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </DockPanel>

                            <Border Grid.Row="1" Background="{StaticResource NavyBrush}" CornerRadius="9"
                                    Padding="14,9" Margin="0,14,0,9">
                                <StackPanel>
                                    <TextBlock x:Name="token_sample"
                                               Text="Sample (selection / first visible row)"
                                               Foreground="#B8D1DF" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="tokenized_sample" Text="Tokens: (none)"
                                               Foreground="White" FontSize="13" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,3,0,0"
                                               FontFamily="Consolas"
                                               AutomationProperties.Name="Source token preview"/>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="token_editor_panel" Grid.Row="2" Visibility="Visible">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DETECTED PARTS" Style="{StaticResource FieldLabelStyle}"
                                               Margin="0" VerticalAlignment="Center"/>
                                    <ScrollViewer Grid.Column="1" MaxHeight="64" Margin="10,0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <WrapPanel x:Name="token_palette"/>
                                    </ScrollViewer>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="btn_add_token" Content="+ Add"
                                                Style="{StaticResource SecondaryButtonStyle}"/>
                                        <Button x:Name="btn_clear_tokens" Content="Clear"
                                                Style="{StaticResource QuietButtonStyle}" Margin="5,0,0,0"
                                                ToolTip="Clear all operations from the composition."
                                                AutomationProperties.Name="Clear all composition operations"/>
                                    </StackPanel>
                                </Grid>

                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="OUTPUT ORDER"
                                               Style="{StaticResource FieldLabelStyle}" Margin="0,2,0,5"/>
                                    <Border BorderBrush="#B9D0DD" BorderThickness="1"
                                            CornerRadius="9" Background="#F9FBFC">
                                        <ScrollViewer x:Name="token_bar_scroll" MinHeight="62" MaxHeight="98"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <Grid>
                                                <WrapPanel x:Name="token_bar" MinHeight="60"
                                                           Background="Transparent" Margin="6"/>
                                                <Canvas IsHitTestVisible="False" ClipToBounds="True">
                                                    <Path x:Name="token_insertion_caret" Visibility="Collapsed"
                                                          Stroke="{StaticResource OrangeBrush}" StrokeThickness="2"
                                                          Data="M0,0 L4,0 M2,0 L2,28 M0,28 L4,28"/>
                                                </Canvas>
                                            </Grid>
                                        </ScrollViewer>
                                    </Border>
                                </DockPanel>
                            </StackPanel>

                            <TextBlock x:Name="token_status" Grid.Row="5" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       Margin="0,9,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16" Margin="0,14,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="03  POLISH" Style="{StaticResource EyebrowStyle}"/>
                                <TextBlock Text="Refine the final value" Style="{StaticResource SectionTitleStyle}" FontSize="17"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="FIND" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="txt_find" FontFamily="Consolas"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="REPLACE" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="txt_replace" FontFamily="Consolas"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock x:Name="txt_final_case" Text="FINAL CASE"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="combo_final_case"
                                              ToolTip="Convert the complete generated value after Find/Replace.">
                                        <ComboBoxItem Content="None" Tag="None"/>
                                        <ComboBoxItem Content="UPPER" Tag="upper"/>
                                        <ComboBoxItem Content="lower" Tag="lower"/>
                                        <ComboBoxItem Content="Title Case" Tag="title"/>
                                        <ComboBoxItem Content="Sentence case" Tag="sentence"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="DELIMITERS" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="txt_delimiters" FontFamily="Consolas"
                                             ToolTip="Characters used to split the source into chips: default - _ / , |"
                                             AutomationProperties.Name="Source token delimiters"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="2" Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="chk_match_whole_word" Content="Match whole word"
                                          Grid.Column="0" IsChecked="False" Margin="0,0,18,0"
                                          ToolTip="Match only when the surrounding characters are not letters, digits or underscores."/>
                                <CheckBox x:Name="chk_match_case" Content="Match case"
                                          Grid.Column="1" IsChecked="True"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                </ScrollViewer>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="18,18,18,8">
                            <TextBlock Text="LIVE PREVIEW" Style="{StaticResource EyebrowStyle}"/>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Proposed values" Style="{StaticResource SectionTitleStyle}"
                                           DockPanel.Dock="Left"/>
                                <Border DockPanel.Dock="Right" Background="{StaticResource OrangeSoftBrush}"
                                        CornerRadius="12" Padding="9,4">
                                    <TextBlock Text="NOT APPLIED" Foreground="{StaticResource OrangeDarkBrush}"
                                               FontSize="9" FontWeight="Bold"/>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="Filter, inspect and choose exactly what to apply."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Row="1" Margin="18,4,18,10" Background="{StaticResource GreenSoftBrush}"
                                CornerRadius="8" Padding="10,8">
                            <TextBlock x:Name="txt_filter_status" Foreground="{StaticResource GreenBrush}"
                                       FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>

                        <DataGrid x:Name="preview_grid" Grid.Row="2" Margin="10,0"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  RowHeaderWidth="0" Background="White" BorderThickness="0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalGridLinesBrush="#E8EEF2"
                                  AlternatingRowBackground="#F7FAFC"
                                  SelectionMode="Extended">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="{StaticResource BlueSoftBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BlueDarkBrush}"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="7,5"/>
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="MinHeight" Value="34"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="5,4"/>
                                    <Setter Property="ToolTip" Value="{Binding tooltip}"/>
                                    <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Use" Binding="{Binding final}" Width="42"
                                                        CanUserSort="False"/>
                                <DataGridTextColumn x:Name="col_sort_value" Binding="{Binding SortValue}"
                                                    SortMemberPath="SortValue" Width="90" IsReadOnly="True"
                                                    Visibility="Collapsed" Header="Sort Value"/>
                                <DataGridTextColumn x:Name="col_current" Binding="{Binding CurrentName}"
                                                    SortMemberPath="CurrentName" Width="*"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.Header>
                                        <StackPanel>
                                            <StackPanel x:Name="current_header_sort_hint"
                                                        Orientation="Horizontal"
                                                        ToolTip="Click to sort ascending.">
                                                <TextBlock Text="CURRENT"/>
                                                <TextBlock x:Name="current_sort_hint" Text=" &#x2195;"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBox x:Name="txt_filter_current" Margin="0,5,0,0"
                                                     MinHeight="28" Height="28" Padding="5,3" FontSize="11"
                                                     ToolTip="Filter Current Value (contains, case-insensitive). Clear to show all."/>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn x:Name="col_new" Binding="{Binding NewName}" Width="*"
                                                    IsReadOnly="True" CanUserSort="False">
                                    <DataGridTextColumn.Header>
                                        <StackPanel>
                                            <TextBlock Text="NEW"/>
                                            <TextBox x:Name="txt_filter_new" Margin="0,5,0,0"
                                                     MinHeight="28" Height="28" Padding="5,3" FontSize="11"
                                                     ToolTip="Filter New Value (contains, case-insensitive). Clear to show all."/>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="5,4"/>
                                            <Setter Property="ToolTip" Value="{Binding tooltip}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding final}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource GreenSoftBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="3" Background="{StaticResource NavyBrush}" CornerRadius="11"
                                Margin="14" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Review before applying"
                                               Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Selected rows stay marked in green."
                                               Foreground="#BBD0DD" FontSize="10" Margin="0,3,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="SAFE"
                                           Foreground="{StaticResource OrangeBrush}" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,0" Padding="18,12">
                <DockPanel LastChildFill="False">
                    <Button x:Name="btn_help" Content="Help &amp; examples"
                            DockPanel.Dock="Left" Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="126"/>
                    <TextBlock DockPanel.Dock="Left" Text="Review the live preview. No model edits occur until Apply."
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               FontSize="11" Margin="14,0,0,0"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="btn_close" Content="Close"
                                Style="{StaticResource QuietButtonStyle}" MinWidth="76"/>
                        <Button x:Name="btn_apply" Content="Apply Re-Values"
                                Style="{StaticResource PrimaryButtonStyle}" MinWidth="164"
                                Margin="8,0,0,0" ToolTipService.ShowOnDisabled="True"
                                IsDefault="True">
                            <Button.Resources>
                                <TextBlock x:Key="NewValueFilterToolTip">
                                    <Run Text="Clear "/><Run Text="New Value" FontWeight="Bold"/><Run Text=" filter to apply"/>
                                </TextBlock>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
